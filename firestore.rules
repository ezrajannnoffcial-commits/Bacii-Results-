rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write for student profiles
    match /students/{candidateNumber} {
      allow read, write: if true;
    }

    // Allow read/write for exam results
    match /examResults/{candidateNumber} {
      allow read, write: if true;
    }

    // Allow read/write for student notifications
    match /notifications/{candidateNumber} {
      allow read, write: if true;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
